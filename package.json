{
  "name": "chatbot-eletrofix",
  "version": "1.0.0",
  "description": "Chatbot inteligente para assistência técnica em eletrônicos - EletroFix",
  "scripts": {
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && next dev --port 3000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "node backend/server.js",
    "start:frontend": "cd frontend && next start",
    "build": "cd frontend && next build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.0.0"
  }
}
